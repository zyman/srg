  "portainer": {"kind": "portainer", "url": "https://portainer.example.internal:9443", "credential": "portainer", "ca_file": "/etc/srg/backend-ca.pem"},
  "ha": {"kind": "home_assistant", "url": "https://ha.example.internal", "credential": "ha", "ca_file": "/etc/srg/backend-ca.pem"}
