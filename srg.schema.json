{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:srg:draft:1",
  "$ref": "#/$defs/controlPolicy",
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actionName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "planId": {"type": "string", "pattern": "^[a-f0-9]{48}$"},
    "planRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "target"],
      "properties": {
        "action": {"$ref": "#/$defs/actionName"},
        "target": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "applyRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id"],
      "properties": {"plan_id": {"$ref": "#/$defs/planId"}}
    },
    "action": {
      "type": "object",
      "required": ["adapter", "operation", "risk", "description", "targets"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "risk": {"const": "routine"},
        "description": {"type": "string", "minLength": 1, "maxLength": 300},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      },
      "additionalProperties": true,
      "$comment": "Additional options belong to the installed trusted adapter and must be validated by it. Unknown adapters and operations fail closed."
    },
    "controlPolicy": {
      "type": "object",
      "required": ["clients", "actions", "write_grants"],
      "properties": {
        "clients": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fingerprint"}},
        "actions": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/actionName"},
          "additionalProperties": {"$ref": "#/$defs/action"}
        },
        "write_grants": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/fingerprint"},
          "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/actionName"}}
        }
      },
      "additionalProperties": true,
      "$comment": "The server also checks every grant references an authorized client and installed action. Transport, reads and state storage are implementation options."
    }
  }
}
